{"uuid":"d8f10fa2-c5ac-472b-acf2-0439674398ed","name":"","description":"","created":"2026-10-11T16:10:41.505Z","updated":"2026-10-11T16:13:57.580Z","data":{"html":"<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<title>Ewen Notes</title>\n\n<style>\n* {\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n}\n\n:root {\n    --yellow: #ffcc33;\n    --background: #ffffff;\n    --secondary: #f2f2f7;\n    --text: #1c1c1e;\n    --muted: #8e8e93;\n    --border: #e5e5ea;\n}\n\nbody {\n    margin: 0;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    background: var(--background);\n    color: var(--text);\n}\n\nbutton, input, textarea, select {\n    font: inherit;\n}\n\nbutton {\n    cursor: pointer;\n}\n\nbutton:active {\n    opacity: 0.7;\n}\n\nheader {\n    position: sticky;\n    top: 0;\n    z-index: 10;\n    background: rgba(255,255,255,0.97);\n    backdrop-filter: blur(15px);\n    border-bottom: 1px solid var(--border);\n    padding: 16px;\n}\n\n.topbar {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 12px;\n}\n\nh1 {\n    font-size: 29px;\n    margin: 0;\n    font-weight: 750;\n    letter-spacing: -0.8px;\n}\n\n.subtitle {\n    color: var(--muted);\n    font-size: 13px;\n    margin-top: 5px;\n}\n\n.round-button {\n    width: 45px;\n    height: 45px;\n    border-radius: 50%;\n    border: none;\n    background: var(--yellow);\n    color: #222;\n    font-size: 30px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n}\n\n.search {\n    width: 100%;\n    border: none;\n    background: var(--secondary);\n    border-radius: 12px;\n    padding: 12px 14px;\n    margin-top: 17px;\n    outline: none;\n    font-size: 16px;\n}\n\n.container {\n    padding: 16px;\n    padding-bottom: 110px;\n}\n\n.section-title {\n    font-size: 13px;\n    color: var(--muted);\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin: 19px 0 10px;\n}\n\n.section-title:first-child {\n    margin-top: 0;\n}\n\n.folder-list {\n    display: flex;\n    gap: 10px;\n    overflow-x: auto;\n    padding-bottom: 8px;\n    scrollbar-width: none;\n}\n\n.folder-list::-webkit-scrollbar {\n    display: none;\n}\n\n.folder {\n    border: 1px solid var(--border);\n    background: white;\n    padding: 12px;\n    border-radius: 14px;\n    min-width: 112px;\n    max-width: 160px;\n    text-align: left;\n    flex-shrink: 0;\n}\n\n.folder.active {\n    background: #fff5cf;\n    border-color: var(--yellow);\n}\n\n.folder-icon {\n    font-size: 25px;\n    display: block;\n    margin-bottom: 8px;\n}\n\n.folder-name {\n    font-size: 14px;\n    font-weight: 650;\n    display: block;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.folder-count {\n    font-size: 12px;\n    color: var(--muted);\n    margin-top: 4px;\n    display: block;\n}\n\n.folder-actions {\n    display: flex;\n    gap: 8px;\n    margin-top: 7px;\n}\n\n.small-button {\n    border: none;\n    background: var(--secondary);\n    border-radius: 10px;\n    padding: 10px 12px;\n    font-size: 13px;\n}\n\n.note-card {\n    width: 100%;\n    border: none;\n    border-bottom: 1px solid var(--border);\n    background: white;\n    padding: 15px 3px;\n    text-align: left;\n    display: block;\n}\n\n.note-card-title {\n    font-weight: 650;\n    font-size: 17px;\n    overflow-wrap: anywhere;\n}\n\n.note-card-preview {\n    color: var(--muted);\n    font-size: 14px;\n    margin-top: 5px;\n    line-height: 1.4;\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n}\n\n.note-card-date {\n    color: var(--muted);\n    font-size: 11px;\n    margin-top: 7px;\n}\n\n.note-card-image {\n    width: 72px;\n    height: 72px;\n    object-fit: cover;\n    border-radius: 10px;\n    margin-top: 9px;\n    margin-right: 5px;\n}\n\n.empty {\n    text-align: center;\n    color: var(--muted);\n    padding: 45px 15px;\n    line-height: 1.6;\n}\n\n.empty-icon {\n    font-size: 45px;\n    margin-bottom: 10px;\n}\n\n.bottom-bar {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background: rgba(255,255,255,0.97);\n    backdrop-filter: blur(15px);\n    border-top: 1px solid var(--border);\n    display: flex;\n    justify-content: space-around;\n    padding: 10px 8px;\n    padding-bottom: max(12px, env(safe-area-inset-bottom));\n    z-index: 20;\n}\n\n.bottom-button {\n    border: none;\n    background: transparent;\n    color: var(--muted);\n    font-size: 12px;\n    min-width: 65px;\n}\n\n.bottom-button span {\n    display: block;\n    font-size: 23px;\n    margin-bottom: 3px;\n}\n\n.bottom-button.active {\n    color: #b18400;\n    font-weight: 700;\n}\n\n#editorScreen {\n    display: none;\n    background: white;\n    min-height: 100vh;\n}\n\n.editor-header {\n    position: sticky;\n    top: 0;\n    background: rgba(255,255,255,0.97);\n    border-bottom: 1px solid var(--border);\n    padding: 12px;\n    z-index: 10;\n}\n\n.editor-toolbar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n}\n\n.text-button {\n    background: transparent;\n    border: none;\n    color: #a57a00;\n    padding: 9px 4px;\n    font-size: 14px;\n}\n\n.editor-actions {\n    display: flex;\n    gap: 10px;\n    align-items: center;\n}\n\n.editor-title {\n    width: 100%;\n    border: none;\n    outline: none;\n    font-size: 27px;\n    font-weight: 750;\n    padding: 18px 18px 8px;\n    color: var(--text);\n}\n\n.editor-meta {\n    color: var(--muted);\n    font-size: 12px;\n    padding: 0 19px 12px;\n}\n\n.editor-folder {\n    margin: 8px 18px 12px;\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    padding: 9px;\n    background: white;\n    max-width: calc(100% - 36px);\n}\n\n.editor-content {\n    display: block;\n    width: 100%;\n    min-height: 35vh;\n    border: none;\n    resize: vertical;\n    outline: none;\n    padding: 8px 19px 25px;\n    font-size: 17px;\n    line-height: 1.65;\n    color: var(--text);\n    background: white;\n}\n\n.image-section {\n    padding: 10px 18px 35px;\n}\n\n.image-heading {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 12px;\n}\n\n.image-heading h3 {\n    font-size: 17px;\n    margin: 0;\n}\n\n.add-image-button {\n    border: none;\n    background: #fff3c4;\n    padding: 10px 13px;\n    border-radius: 12px;\n    font-size: 14px;\n    font-weight: 650;\n    color: #705400;\n}\n\n.image-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 10px;\n}\n\n.image-item {\n    position: relative;\n    overflow: hidden;\n    border-radius: 13px;\n    background: var(--secondary);\n    aspect-ratio: 1 / 1;\n}\n\n.image-item img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n}\n\n.image-open {\n    padding: 0;\n    border: none;\n    width: 100%;\n    height: 100%;\n    background: transparent;\n}\n\n.image-delete {\n    position: absolute;\n    top: 7px;\n    right: 7px;\n    width: 31px;\n    height: 31px;\n    border: none;\n    border-radius: 50%;\n    background: rgba(0,0,0,0.7);\n    color: white;\n    font-size: 18px;\n    z-index: 2;\n}\n\n.no-images {\n    color: var(--muted);\n    font-size: 14px;\n    padding: 18px 10px;\n    background: #f7f7f9;\n    border-radius: 12px;\n    text-align: center;\n}\n\n.modal-backdrop {\n    display: none;\n    position: fixed;\n    inset: 0;\n    background: rgba(0,0,0,0.35);\n    z-index: 100;\n    align-items: center;\n    justify-content: center;\n    padding: 22px;\n}\n\n.modal {\n    width: 100%;\n    max-width: 360px;\n    background: white;\n    padding: 22px;\n    border-radius: 20px;\n    box-shadow: 0 12px 50px rgba(0,0,0,0.15);\n    max-height: 85vh;\n    overflow-y: auto;\n}\n\n.modal h2 {\n    margin: 0 0 16px;\n    font-size: 21px;\n}\n\n.modal input, .modal select {\n    width: 100%;\n    border: 1px solid var(--border);\n    border-radius: 11px;\n    padding: 13px;\n    outline: none;\n    background: white;\n    margin-bottom: 12px;\n}\n\n.modal-buttons {\n    display: flex;\n    justify-content: flex-end;\n    gap: 10px;\n    margin-top: 10px;\n}\n\n.modal-buttons button {\n    border: none;\n    padding: 11px 15px;\n    border-radius: 11px;\n}\n\n.cancel-button {\n    background: var(--secondary);\n}\n\n.confirm-button {\n    background: var(--yellow);\n    font-weight: 700;\n}\n\n.toast {\n    position: fixed;\n    bottom: 95px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: #292929;\n    color: white;\n    padding: 11px 17px;\n    border-radius: 12px;\n    font-size: 13px;\n    z-index: 200;\n    display: none;\n    max-width: 90%;\n    text-align: center;\n}\n\n#imageViewer {\n    display: none;\n    position: fixed;\n    inset: 0;\n    z-index: 300;\n    background: rgba(0,0,0,0.96);\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    padding: 15px;\n}\n\n#imageViewer img {\n    max-width: 100%;\n    max-height: 82vh;\n    object-fit: contain;\n}\n\n.viewer-close {\n    align-self: flex-end;\n    border: none;\n    background: transparent;\n    color: white;\n    font-size: 32px;\n    padding: 5px 12px 15px;\n}\n\n@media (min-width: 700px) {\n    .container {\n        max-width: 800px;\n        margin: auto;\n    }\n\n    header {\n        padding-left: max(20px, calc((100vw - 760px) / 2));\n        padding-right: max(20px, calc((100vw - 760px) / 2));\n    }\n\n    .editor-content, .editor-title {\n        max-width: 800px;\n        margin-left: auto;\n        margin-right: auto;\n        display: block;\n    }\n\n    .image-grid {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n}\n</style>\n</head>\n\n<body>\n\n<div id=\"homeScreen\">\n\n<header>\n    <div class=\"topbar\">\n        <div>\n            <h1>Notes</h1>\n            <div class=\"subtitle\" id=\"noteCount\">Tes idées, au même endroit.</div>\n        </div>\n        <button class=\"round-button\" onclick=\"newNote()\" aria-label=\"Créer une note\">+</button>\n    </div>\n\n    <input class=\"search\" id=\"searchInput\" type=\"search\"\n           placeholder=\"🔍 Rechercher une note...\"\n           oninput=\"renderNotes()\">\n</header>\n\n<main class=\"container\">\n\n    <div class=\"section-title\">Mes dossiers</div>\n\n    <div class=\"folder-list\" id=\"folderList\"></div>\n\n    <div class=\"folder-actions\">\n        <button class=\"small-button\" onclick=\"createFolder()\">＋ Nouveau dossier</button>\n        <button class=\"small-button\" onclick=\"manageFolders()\">⚙️ Gérer</button>\n    </div>\n\n    <div class=\"section-title\" id=\"notesHeading\">Toutes mes notes</div>\n\n    <div id=\"notesList\"></div>\n\n</main>\n\n<nav class=\"bottom-bar\">\n    <button class=\"bottom-button active\" id=\"navAll\" onclick=\"showAllNotes()\">\n        <span>📝</span>Notes\n    </button>\n    <button class=\"bottom-button\" id=\"navFolders\" onclick=\"focusFolders()\">\n        <span>📁</span>Dossiers\n    </button>\n    <button class=\"bottom-button\" onclick=\"newNote()\">\n        <span>✚</span>Nouvelle\n    </button>\n</nav>\n\n</div>\n\n<div id=\"editorScreen\">\n\n    <div class=\"editor-header\">\n        <div class=\"editor-toolbar\">\n            <button class=\"text-button\" onclick=\"closeEditor()\">‹ Notes</button>\n\n            <div class=\"editor-actions\">\n                <button class=\"text-button\" onclick=\"renameCurrentNote()\">Renommer</button>\n                <button class=\"text-button\" onclick=\"deleteCurrentNote()\">Supprimer</button>\n            </div>\n        </div>\n    </div>\n\n    <input id=\"editorTitle\" class=\"editor-title\"\n           placeholder=\"Titre de la note\"\n           maxlength=\"120\">\n\n    <div class=\"editor-meta\" id=\"editorDate\">Nouvelle note</div>\n\n    <select class=\"editor-folder\" id=\"editorFolder\"\n            onchange=\"changeNoteFolder()\"\n            aria-label=\"Dossier de la note\"></select>\n\n    <textarea id=\"editorContent\" class=\"editor-content\"\n              placeholder=\"Commence à écrire...\"></textarea>\n\n    <section class=\"image-section\">\n        <div class=\"image-heading\">\n            <h3>🖼️ Images</h3>\n            <button class=\"add-image-button\" onclick=\"chooseImages()\">\n                ＋ Ajouter\n            </button>\n        </div>\n\n        <div id=\"imageGrid\" class=\"image-grid\"></div>\n    </section>\n\n</div>\n\n<input type=\"file\" id=\"imagePicker\"\n       accept=\"image/*\" multiple\n       style=\"display:none\">\n\n<div class=\"modal-backdrop\" id=\"modalBackdrop\">\n    <div class=\"modal\">\n        <h2 id=\"modalTitle\">Nouvelle note</h2>\n        <div id=\"modalFields\"></div>\n        <div class=\"modal-buttons\">\n            <button class=\"cancel-button\" onclick=\"closeModal()\">Annuler</button>\n            <button class=\"confirm-button\" id=\"modalConfirm\">Créer</button>\n        </div>\n    </div>\n</div>\n\n<div id=\"imageViewer\">\n    <button class=\"viewer-close\" onclick=\"closeImageViewer()\">✕</button>\n    <img id=\"viewerImage\" src=\"\" alt=\"Image agrandie\">\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n\"use strict\";\n\nconst STORAGE_KEY = \"ewen_notes_data_v2\";\n\nlet data;\nlet currentNoteId = null;\nlet currentFolderId = \"all\";\nlet toastTimer;\n\nfunction uid() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 9);\n}\n\nfunction defaultData() {\n    return {\n        folders: [\n            { id: \"general\", name: \"Général\", emoji: \"📂\" },\n            { id: \"code\", name: \"Ewen Code\", emoji: \"💻\" },\n            { id: \"devoirs\", name: \"Devoirs\", emoji: \"📚\" },\n            { id: \"messages\", name: \"Messages\", emoji: \"💬\" }\n        ],\n        notes: []\n    };\n}\n\nfunction loadData() {\n    try {\n        const saved = localStorage.getItem(STORAGE_KEY);\n\n        if (saved) {\n            const parsed = JSON.parse(saved);\n\n            if (parsed && Array.isArray(parsed.folders)\n                && Array.isArray(parsed.notes)) {\n                data = parsed;\n\n                if (!data.folders.some(f => f.id === \"general\")) {\n                    data.folders.unshift({\n                        id: \"general\",\n                        name: \"Général\",\n                        emoji: \"📂\"\n                    });\n                }\n\n                data.notes.forEach(note => {\n                    if (!data.folders.some(f => f.id === note.folderId)) {\n                        note.folderId = \"general\";\n                    }\n\n                    if (!Array.isArray(note.images)) {\n                        note.images = [];\n                    }\n                });\n\n                return;\n            }\n        }\n    } catch (error) {\n        console.error(\"Erreur de lecture :\", error);\n    }\n\n    data = defaultData();\n    saveData();\n}\n\nfunction saveData() {\n    try {\n        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));\n        return true;\n    } catch (error) {\n        showToast(\"Stockage plein : certaines images sont peut-être trop lourdes.\");\n        return false;\n    }\n}\n\nfunction escapeHTML(value) {\n    return String(value).replace(/[&<>\"']/g, character => ({\n        \"&\": \"&amp;\",\n        \"<\": \"&lt;\",\n        \">\": \"&gt;\",\n        '\"': \"&quot;\",\n        \"'\": \"&#39;\"\n    })[character]);\n}\n\nfunction getFolder(id) {\n    return data.folders.find(folder => folder.id === id);\n}\n\nfunction getCurrentNote() {\n    return data.notes.find(note => note.id === currentNoteId);\n}\n\nfunction formatDate(timestamp) {\n    return new Date(timestamp).toLocaleDateString(\"fr-FR\", {\n        day: \"numeric\",\n        month: \"short\",\n        hour: \"2-digit\",\n        minute: \"2-digit\"\n    });\n}\n\nfunction showToast(message) {\n    const toast = document.getElementById(\"toast\");\n    toast.textContent = message;\n    toast.style.display = \"block\";\n\n    clearTimeout(toastTimer);\n\n    toastTimer = setTimeout(() => {\n        toast.style.display = \"none\";\n    }, 2600);\n}\n\nfunction renderFolders() {\n    const list = document.getElementById(\"folderList\");\n\n    const allCount = data.notes.length;\n\n    let html = `\n        <button class=\"folder ${currentFolderId === \"all\" ? \"active\" : \"\"}\"\n                onclick=\"selectFolder('all')\">\n            <span class=\"folder-icon\">🗂️</span>\n            <span class=\"folder-name\">Toutes</span>\n            <span class=\"folder-count\">${allCount} note${allCount !== 1 ? \"s\" : \"\"}</span>\n        </button>\n    `;\n\n    data.folders.forEach(folder => {\n        const count = data.notes.filter(note =>\n            note.folderId === folder.id\n        ).length;\n\n        html += `\n            <button class=\"folder ${currentFolderId === folder.id ? \"active\" : \"\"}\"\n                    onclick=\"selectFolder('${folder.id}')\">\n                <span class=\"folder-icon\">${escapeHTML(folder.emoji)}</span>\n                <span class=\"folder-name\">${escapeHTML(folder.name)}</span>\n                <span class=\"folder-count\">${count} note${count !== 1 ? \"s\" : \"\"}</span>\n            </button>\n        `;\n    });\n\n    list.innerHTML = html;\n}\n\nfunction renderNotes() {\n    renderFolders();\n\n    const query = document.getElementById(\"searchInput\").value\n        .trim().toLowerCase();\n\n    const visibleNotes = data.notes\n        .filter(note => {\n            const folderMatch = currentFolderId === \"all\"\n                || note.folderId === currentFolderId;\n\n            const textMatch = !query\n                || (note.title || \"\").toLowerCase().includes(query)\n                || (note.content || \"\").toLowerCase().includes(query);\n\n            return folderMatch && textMatch;\n        })\n        .sort((a, b) => b.updatedAt - a.updatedAt);\n\n    const folder = getFolder(currentFolderId);\n\n    document.getElementById(\"notesHeading\").textContent =\n        currentFolderId === \"all\"\n            ? \"Toutes mes notes\"\n            : \"Notes · \" + folder.name;\n\n    document.getElementById(\"noteCount\").textContent =\n        data.notes.length + \" note\" +\n        (data.notes.length !== 1 ? \"s\" : \"\") +\n        \" enregistrée\" +\n        (data.notes.length !== 1 ? \"s\" : \"\");\n\n    const list = document.getElementById(\"notesList\");\n\n    if (visibleNotes.length === 0) {\n        list.innerHTML = `\n            <div class=\"empty\">\n                <div class=\"empty-icon\">${query ? \"🔎\" : \"📝\"}</div>\n                <div><strong>${query ? \"Aucun résultat\" : \"Aucune note pour le moment\"}</strong></div>\n                <div>${query ? \"Essaie avec d'autres mots.\" : \"Appuie sur le bouton + pour écrire ta première note.\"}</div>\n            </div>\n        `;\n        return;\n    }\n\n    list.innerHTML = visibleNotes.map(note => {\n        const title = note.title.trim() || \"Nouvelle note\";\n        const preview = note.content.trim() || \"Aucun texte\";\n        const folderName = getFolder(note.folderId)?.name || \"Général\";\n\n        const images = Array.isArray(note.images) ? note.images : [];\n\n        const imagePreview = images.length\n            ? `<img class=\"note-card-image\" src=\"${images[0].data}\" alt=\"Image de la note\">`\n            : \"\";\n\n        return `\n            <button class=\"note-card\" onclick=\"openNote('${note.id}')\">\n                <div class=\"note-card-title\">${escapeHTML(title)}</div>\n                <div class=\"note-card-preview\">${escapeHTML(preview)}</div>\n                ${imagePreview}\n                <div class=\"note-card-date\">\n                    ${escapeHTML(folderName)} · ${escapeHTML(formatDate(note.updatedAt))}\n                    ${images.length ? \" · 🖼️ \" + images.length : \"\"}\n                </div>\n            </button>\n        `;\n    }).join(\"\");\n}\n\nfunction selectFolder(id) {\n    currentFolderId = id;\n\n    document.getElementById(\"navAll\").classList.toggle(\"active\", id === \"all\");\n    document.getElementById(\"navFolders\").classList.toggle(\"active\", id !== \"all\");\n\n    renderNotes();\n}\n\nfunction showAllNotes() {\n    currentFolderId = \"all\";\n\n    document.getElementById(\"navAll\").classList.add(\"active\");\n    document.getElementById(\"navFolders\").classList.remove(\"active\");\n\n    renderNotes();\n}\n\nfunction focusFolders() {\n    document.getElementById(\"folderList\").scrollIntoView({\n        behavior: \"smooth\",\n        block: \"center\"\n    });\n\n    document.getElementById(\"navFolders\").classList.add(\"active\");\n    document.getElementById(\"navAll\").classList.remove(\"active\");\n}\n\nfunction createFolder() {\n    openModal(\"Créer un dossier\", `\n        <input id=\"folderNameInput\" placeholder=\"Nom du dossier\" maxlength=\"50\">\n        <select id=\"folderEmojiInput\">\n            <option value=\"📁\">📁 Dossier classique</option>\n            <option value=\"💻\">💻 Informatique</option>\n            <option value=\"📚\">📚 École</option>\n            <option value=\"💬\">💬 Messages</option>\n            <option value=\"⭐\">⭐ Favoris</option>\n            <option value=\"💡\">💡 Idées</option>\n            <option value=\"🎮\">🎮 Jeux</option>\n            <option value=\"📷\">📷 Photos</option>\n            <option value=\"📝\">📝 Personnel</option>\n            <option value=\"🎵\">🎵 Musique</option>\n        </select>\n    `, () => {\n        const name = document.getElementById(\"folderNameInput\").value.trim();\n        const emoji = document.getElementById(\"folderEmojiInput\").value;\n\n        if (!name) {\n            showToast(\"Donne un nom au dossier.\");\n            return false;\n        }\n\n        if (data.folders.some(folder =>\n            folder.name.toLowerCase() === name.toLowerCase()\n        )) {\n            showToast(\"Ce dossier existe déjà.\");\n            return false;\n        }\n\n        const folder = { id: uid(), name, emoji };\n\n        data.folders.push(folder);\n        currentFolderId = folder.id;\n\n        saveData();\n        renderNotes();\n        showToast(\"Dossier créé !\");\n\n        return true;\n    });\n\n    setTimeout(() => document.getElementById(\"folderNameInput\")?.focus(), 100);\n}\n\nfunction manageFolders() {\n    const options = data.folders.map(folder =>\n        `<option value=\"${folder.id}\">${escapeHTML(folder.emoji)} ${escapeHTML(folder.name)}</option>`\n    ).join(\"\");\n\n    openModal(\"Gérer les dossiers\", `\n        <p style=\"font-size:14px;color:#777;margin-top:0\">\n            Renommer ou supprimer un dossier. Ses notes seront déplacées vers Général.\n        </p>\n        <select id=\"manageFolderSelect\">${options}</select>\n        <input id=\"manageFolderName\" placeholder=\"Nouveau nom\">\n        <div style=\"display:flex;gap:8px\">\n            <button type=\"button\" class=\"small-button\" style=\"flex:1\"\n                    onclick=\"renameFolderFromManager()\">Renommer</button>\n            <button type=\"button\" class=\"small-button\" style=\"flex:1;color:#c00\"\n                    onclick=\"deleteFolderFromManager()\">Supprimer</button>\n        </div>\n    `, () => true, \"Terminer\");\n\n    const select = document.getElementById(\"manageFolderSelect\");\n\n    select.addEventListener(\"change\", () => {\n        const folder = getFolder(select.value);\n        document.getElementById(\"manageFolderName\").value =\n            folder ? folder.name : \"\";\n    });\n\n    select.dispatchEvent(new Event(\"change\"));\n}\n\nfunction renameFolderFromManager() {\n    const select = document.getElementById(\"manageFolderSelect\");\n    const input = document.getElementById(\"manageFolderName\");\n\n    const folder = getFolder(select.value);\n    const name = input.value.trim();\n\n    if (!folder || !name) {\n        showToast(\"Entre un nom valide.\");\n        return;\n    }\n\n    if (data.folders.some(other =>\n        other.id !== folder.id &&\n        other.name.toLowerCase() === name.toLowerCase()\n    )) {\n        showToast(\"Ce nom est déjà utilisé.\");\n        return;\n    }\n\n    folder.name = name;\n\n    saveData();\n    renderNotes();\n    showToast(\"Dossier renommé.\");\n\n    manageFolders();\n}\n\nfunction deleteFolderFromManager() {\n    const select = document.getElementById(\"manageFolderSelect\");\n    const folder = getFolder(select.value);\n\n    if (!folder) return;\n\n    if (folder.id === \"general\") {\n        showToast(\"Le dossier Général ne peut pas être supprimé.\");\n        return;\n    }\n\n    if (!confirm('Supprimer \"' + folder.name +\n        '\" ? Ses notes seront déplacées vers Général.')) {\n        return;\n    }\n\n    data.notes.forEach(note => {\n        if (note.folderId === folder.id) {\n            note.folderId = \"general\";\n            note.updatedAt = Date.now();\n        }\n    });\n\n    data.folders = data.folders.filter(f => f.id !== folder.id);\n\n    if (currentFolderId === folder.id) currentFolderId = \"all\";\n\n    saveData();\n    renderNotes();\n    showToast(\"Dossier supprimé.\");\n\n    manageFolders();\n}\n\nfunction newNote() {\n    const defaultFolder = currentFolderId !== \"all\"\n        ? currentFolderId\n        : \"general\";\n\n    const options = data.folders.map(folder =>\n        `<option value=\"${folder.id}\" ${folder.id === defaultFolder ? \"selected\" : \"\"}>${escapeHTML(folder.emoji)} ${escapeHTML(folder.name)}</option>`\n    ).join(\"\");\n\n    openModal(\"Nouvelle note\", `\n        <input id=\"newNoteTitle\" placeholder=\"Nom de la note\" maxlength=\"120\">\n        <select id=\"newNoteFolder\">${options}</select>\n    `, () => {\n        const title = document.getElementById(\"newNoteTitle\").value.trim();\n        const folderId = document.getElementById(\"newNoteFolder\").value;\n\n        if (!title) {\n            showToast(\"Donne un nom à ta note.\");\n            return false;\n        }\n\n        const note = {\n            id: uid(),\n            title,\n            content: \"\",\n            folderId,\n            images: [],\n            createdAt: Date.now(),\n            updatedAt: Date.now()\n        };\n\n        data.notes.push(note);\n        saveData();\n        renderNotes();\n        openNote(note.id);\n\n        return true;\n    }, \"Créer\");\n\n    setTimeout(() => document.getElementById(\"newNoteTitle\")?.focus(), 100);\n}\n\nfunction openNote(id) {\n    const note = data.notes.find(item => item.id === id);\n    if (!note) return;\n\n    currentNoteId = id;\n\n    if (!Array.isArray(note.images)) note.images = [];\n\n    document.getElementById(\"homeScreen\").style.display = \"none\";\n    document.getElementById(\"editorScreen\").style.display = \"block\";\n\n    document.getElementById(\"editorTitle\").value = note.title;\n    document.getElementById(\"editorContent\").value = note.content;\n\n    document.getElementById(\"editorDate\").textContent =\n        \"Modifiée le \" + formatDate(note.updatedAt);\n\n    renderEditorFolders();\n    renderImages();\n\n    window.scrollTo(0, 0);\n}\n\nfunction renderEditorFolders() {\n    const select = document.getElementById(\"editorFolder\");\n    const note = getCurrentNote();\n\n    if (!note) return;\n\n    select.innerHTML = data.folders.map(folder =>\n        `<option value=\"${folder.id}\" ${folder.id === note.folderId ? \"selected\" : \"\"}>${escapeHTML(folder.emoji)} ${escapeHTML(folder.name)}</option>`\n    ).join(\"\");\n}\n\nfunction saveCurrentNote() {\n    const note = getCurrentNote();\n    if (!note) return;\n\n    note.title = document.getElementById(\"editorTitle\").value;\n    note.content = document.getElementById(\"editorContent\").value;\n    note.updatedAt = Date.now();\n\n    saveData();\n\n    document.getElementById(\"editorDate\").textContent =\n        \"Modifiée le \" + formatDate(note.updatedAt);\n}\n\nfunction changeNoteFolder() {\n    const note = getCurrentNote();\n    if (!note) return;\n\n    note.folderId = document.getElementById(\"editorFolder\").value;\n    note.updatedAt = Date.now();\n\n    saveData();\n    renderNotes();\n\n    showToast(\"Note déplacée dans le dossier.\");\n}\n\nfunction closeEditor() {\n    saveCurrentNote();\n\n    document.getElementById(\"editorScreen\").style.display = \"none\";\n    document.getElementById(\"homeScreen\").style.display = \"block\";\n\n    currentNoteId = null;\n\n    renderNotes();\n    window.scrollTo(0, 0);\n}\n\n/* AJOUTER DES IMAGES */\n\nfunction chooseImages() {\n    if (!getCurrentNote()) return;\n\n    const picker = document.getElementById(\"imagePicker\");\n    picker.setAttribute(\"accept\", \"image/*\");\n    picker.removeAttribute(\"capture\");\n    picker.click();\n}\n\ndocument.getElementById(\"imagePicker\").addEventListener(\"change\", async function(event) {\n    const files = Array.from(event.target.files || []);\n    const note = getCurrentNote();\n\n    if (!note || files.length === 0) {\n        event.target.value = \"\";\n        return;\n    }\n\n    if (!Array.isArray(note.images)) note.images = [];\n\n    for (const file of files) {\n        if (!file.type.startsWith(\"image/\")) {\n            showToast(\"Choisis un fichier image.\");\n            continue;\n        }\n\n        try {\n            showToast(\"Préparation de l'image...\");\n\n            const compressed = await compressImage(file);\n\n            note.images.push({\n                id: uid(),\n                data: compressed,\n                name: file.name || \"Image\"\n            });\n\n            note.updatedAt = Date.now();\n\n            const success = saveData();\n\n            renderImages();\n            renderNotes();\n\n            if (success) {\n                showToast(\"Image ajoutée à ta note !\");\n            }\n        } catch (error) {\n            console.error(error);\n            showToast(\"Impossible de charger cette image.\");\n        }\n    }\n\n    event.target.value = \"\";\n});\n\nfunction compressImage(file) {\n    return new Promise((resolve, reject) => {\n        const reader = new FileReader();\n\n        reader.onerror = () => reject(new Error(\"Lecture impossible\"));\n\n        reader.onload = () => {\n            const img = new Image();\n\n            img.onerror = () => reject(new Error(\"Image invalide\"));\n\n            img.onload = () => {\n                const maxSize = 1400;\n\n                let width = img.width;\n                let height = img.height;\n\n                const scale = Math.min(1, maxSize / Math.max(width, height));\n\n                width = Math.max(1, Math.round(width * scale));\n                height = Math.max(1, Math.round(height * scale));\n\n                const canvas = document.createElement(\"canvas\");\n                canvas.width = width;\n                canvas.height = height;\n\n                const context = canvas.getContext(\"2d\");\n\n                if (!context) {\n                    reject(new Error(\"Canvas indisponible\"));\n                    return;\n                }\n\n                context.fillStyle = \"#ffffff\";\n                context.fillRect(0, 0, width, height);\n\n                context.drawImage(img, 0, 0, width, height);\n\n                resolve(canvas.toDataURL(\"image/jpeg\", 0.75));\n            };\n\n            img.src = reader.result;\n        };\n\n        reader.readAsDataURL(file);\n    });\n}\n\nfunction renderImages() {\n    const note = getCurrentNote();\n    const grid = document.getElementById(\"imageGrid\");\n\n    if (!note) {\n        grid.innerHTML = \"\";\n        return;\n    }\n\n    if (!Array.isArray(note.images)) note.images = [];\n\n    if (note.images.length === 0) {\n        grid.innerHTML = `\n            <div class=\"no-images\" style=\"grid-column:1/-1\">\n                Aucune image pour le moment.<br>\n                Appuie sur « ＋ Ajouter » pour choisir une photo.\n            </div>\n        `;\n        return;\n    }\n\n    grid.innerHTML = note.images.map(image => `\n        <div class=\"image-item\">\n            <button class=\"image-open\"\n                    onclick=\"openImageViewer('${image.id}')\"\n                    aria-label=\"Agrandir l'image\">\n                <img src=\"${image.data}\" alt=\"${escapeHTML(image.name || \"Image de la note\")}\">\n            </button>\n            <button class=\"image-delete\"\n                    onclick=\"deleteImage('${image.id}')\"\n                    aria-label=\"Supprimer cette image\">×</button>\n        </div>\n    `).join(\"\");\n}\n\nfunction openImageViewer(imageId) {\n    const note = getCurrentNote();\n    if (!note) return;\n\n    const image = note.images.find(item => item.id === imageId);\n    if (!image) return;\n\n    document.getElementById(\"viewerImage\").src = image.data;\n    document.getElementById(\"imageViewer\").style.display = \"flex\";\n}\n\nfunction closeImageViewer() {\n    document.getElementById(\"imageViewer\").style.display = \"none\";\n    document.getElementById(\"viewerImage\").src = \"\";\n}\n\nfunction deleteImage(imageId) {\n    const note = getCurrentNote();\n    if (!note) return;\n\n    if (!confirm(\"Supprimer cette image de la note ?\")) return;\n\n    note.images = note.images.filter(image => image.id !== imageId);\n    note.updatedAt = Date.now();\n\n    saveData();\n    renderImages();\n    renderNotes();\n\n    showToast(\"Image supprimée.\");\n}\n\nfunction renameCurrentNote() {\n    const note = getCurrentNote();\n    if (!note) return;\n\n    openModal(\"Renommer la note\", `\n        <input id=\"renameNoteInput\" value=\"${escapeHTML(note.title)}\" maxlength=\"120\">\n    `, () => {\n        const title = document.getElementById(\"renameNoteInput\").value.trim();\n\n        if (!title) {\n            showToast(\"Le titre ne peut pas être vide.\");\n            return false;\n        }\n\n        note.title = title;\n        note.updatedAt = Date.now();\n\n        document.getElementById(\"editorTitle\").value = title;\n\n        saveData();\n        renderNotes();\n\n        showToast(\"Note renommée.\");\n\n        return true;\n    }, \"Enregistrer\");\n\n    setTimeout(() => document.getElementById(\"renameNoteInput\")?.focus(), 100);\n}\n\nfunction deleteCurrentNote() {\n    const note = getCurrentNote();\n    if (!note) return;\n\n    if (!confirm('Supprimer définitivement la note \"' +\n        (note.title || \"Sans titre\") + '\" ?')) {\n        return;\n    }\n\n    data.notes = data.notes.filter(item => item.id !== note.id);\n\n    saveData();\n\n    document.getElementById(\"editorScreen\").style.display = \"none\";\n    document.getElementById(\"homeScreen\").style.display = \"block\";\n\n    currentNoteId = null;\n\n    renderNotes();\n    showToast(\"Note supprimée.\");\n}\n\nfunction openModal(title, fieldsHTML, onConfirm, confirmText = \"Créer\") {\n    document.getElementById(\"modalTitle\").textContent = title;\n    document.getElementById(\"modalFields\").innerHTML = fieldsHTML;\n    document.getElementById(\"modalConfirm\").textContent = confirmText;\n\n    document.getElementById(\"modalConfirm\").onclick = () => {\n        const result = onConfirm();\n\n        if (result !== false) {\n            closeModal();\n        }\n    };\n\n    document.getElementById(\"modalBackdrop\").style.display = \"flex\";\n}\n\nfunction closeModal() {\n    document.getElementById(\"modalBackdrop\").style.display = \"none\";\n    document.getElementById(\"modalFields\").innerHTML = \"\";\n}\n\ndocument.getElementById(\"editorTitle\").addEventListener(\"input\", () => {\n    saveCurrentNote();\n});\n\ndocument.getElementById(\"editorContent\").addEventListener(\"input\", () => {\n    saveCurrentNote();\n});\n\ndocument.getElementById(\"modalBackdrop\").addEventListener(\"click\", event => {\n    if (event.target.id === \"modalBackdrop\") closeModal();\n});\n\ndocument.getElementById(\"imageViewer\").addEventListener(\"click\", event => {\n    if (event.target.id === \"imageViewer\") closeImageViewer();\n});\n\ndocument.addEventListener(\"keydown\", event => {\n    if (event.key === \"Escape\") {\n        closeModal();\n        closeImageViewer();\n    }\n});\n\nloadData();\nrenderNotes();\n</script>\n\n</body>\n</html>","css":"","javascript":""}}